# .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요. (secrets.toml은 Git에 올라가지 않습니다)

# ── Gemini (선택: 없으면 AI 기능만 꺼지고 학습은 정상 동작) ──
# https://aistudio.google.com/apikey 에서 발급. 무료 한도는 https://aistudio.google.com/rate-limit 에서 확인.
GEMINI_API_KEY = ""
GEMINI_MODEL_MAIN = "gemini-3.6-flash"        # 필기 OCR·문장 교정·TOEIC 문제
GEMINI_MODEL_LITE = "gemini-3.5-flash-lite"   # 예문·자동완성·비교표
ENABLE_AI = "true"
DAILY_AI_REQUEST_BUDGET = "40"                # 사용자당 최근 24시간 실제 API 호출 상한

# ── Supabase (선택: 없으면 로컬 모드 — 이 PC에만 저장, 로그인 없음) ──
# 프로젝트 Settings → API 의 URL과 anon(또는 publishable) 키. service_role/secret 키는 절대 넣지 마세요.
SUPABASE_URL = ""
SUPABASE_ANON_KEY = ""

APP_TIMEZONE = "Asia/Seoul"
HANDWRITING_MAX_BYTES = "1500000"
HANDWRITING_MAX_SIDE = "2048"
